NEXT_PUBLIC_SUPABASE_URL=https://wxvaahhlywaklpfuocak.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key, from Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_project_publishable_or_anon_key

# ---- Server-only secrets (never prefix with NEXT_PUBLIC_, never commit real values) ----
# Supabase → Project Settings → API Keys → service_role / secret key. Used only by server code
# to start AI jobs and move credits.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
# Claude API key from https://platform.claude.com (Settings → API Keys).
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
# Optional. Defaults to claude-sonnet-5-5.
# AI_MODEL=claude-sonnet-5-5

# ---- PDF worker (Compress, Repair, Protect, Unlock, Office to PDF, PDF to JPG) ----
# Deploy /pdf-worker (see pdf-worker/README.md), then set both. Server-only.
# PDF_WORKER_URL=https://your-pdf-worker.example.com
# PDF_WORKER_SECRET=same-random-value-as-the-worker-at-least-32-characters

# ---- Payments (Razorpay) ----
# Dashboard → Account & Settings → API Keys. Use test keys (rzp_test_...) until you go live.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=server_only_secret
# Dashboard → Webhooks → Add: URL https://<your-domain>/api/billing/webhook, events payment.captured, payment.failed, order.paid
# RAZORPAY_WEBHOOK_SECRET=the_secret_you_typed_when_creating_the_webhook

# ---- Usage analytics (optional, PostHog) ----
# Anonymous page views and feature use, no cookies. Leave unset to turn analytics off.
# PostHog → Project settings → Project API key (starts with phc_). Host: EU https://eu.i.posthog.com or US https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
